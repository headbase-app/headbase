{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "lib": ["ES2024", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
		"strict": true,
    "noFallthroughCasesInSwitch": true,

		/* Linting OVERWRITE - Allow for easier local development, rely on eslint warnings for this instead */
		"noUnusedLocals": false,
		"noUnusedParameters": false,

		/* Linting OVERWRITE - Overwritten from default to allow 'private readonly' when typing constructor injection  */
		"erasableSyntaxOnly": false,

		/* Adding custom path aliases for cleaner imports */
		"paths": {
			"@headbase-app/lib": [
				"./src/lib/index.ts"
			],
			"@common/*": [
				"./src/common/*"
			],
			"@apis/*": [
				"./src/apis/*"
			],
			"@framework/*": [
				"./src/framework/*"
			],
			"@ui/*": [
				"./src/ui/*"
			]
		}
  },
  "include": ["src"]
}
