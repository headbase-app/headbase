{
	"name": "@headbase-app/web",
	"version": "0.0.0",
	"description": "An experimental personal productivity app. Create content databases and query with views like a list, table, kanban board, calendar, canvas and graph.",
	"private": true,
	"license": "AGPL-3.0-only",
	"keywords": [],
	"author": {
		"name": "Ben Ryder",
		"email": "dev@benryder.me"
	},
	"homepage": "https://github.com/headbase-app/headbase#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/headbase-app/headbase.git"
	},
	"bugs": {
		"url": "https://github.com/headbase-app/headbase/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"start:sb": "storybook dev -p 6006",
		"build": "tsc -b && vite build",
		"build:sb": "storybook build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:e2e": "npx playwright test",
		"test:e2e:ui": "npx playwright test --ui",
		"test:e2e:report": "npx playwright show-report",
		"test:e2e:setup": "npx playwright install"
	},
	"dependencies": {
		"@sqlite.org/sqlite-wasm": "^3.54.1-build1",
		"lit-html": "^3.3.3",
		"lucide-static": "^1.72.0",
		"opfsx": "^0.1.0",
		"pdfjs-dist": "^6.5.438",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"typescript": "~7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	}
}
